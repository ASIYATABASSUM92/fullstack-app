cat > frontend/src/App.js << 'EOF'
import React, { useState, useEffect } from 'react';
import axios from 'axios';
const API = 'http://localhost:3002/api';
function App() {
  const [todos, setTodos] = useState([]);
  const [input, setInput] = useState('');
  useEffect(() => { axios.get(API + '/todos').then(r => setTodos(r.data)); }, []);
  const add = () => { if (!input) return; axios.post(API + '/todos', {title: input}).then(r => { setTodos([r.data, ...todos]); setInput(''); }); };
  const del = (id) => { axios.delete(API + '/todos/' + id).then(() => setTodos(todos.filter(t => t._id !== id))); };
  return (
    <div style={{padding:'20px', maxWidth:'600px', margin:'auto'}}>
      <h1>📝 Todo App</h1>
      <input value={input} onChange={e => setInput(e.target.value)} placeholder="Add task..." style={{padding:'10px', width:'70%'}} />
      <button onClick={add} style={{padding:'10px 20px', marginLeft:'10px'}}>Add</button>
      <ul style={{listStyle:'none', padding:0}}>
        {todos.map(t => (
          <li key={t._id} style={{padding:'15px', marginBottom:'10px', background:'#f5f5f5', display:'flex', justifyContent:'space-between'}}>
            <span>{t.title}</span>
            <button onClick={() => del(t._id)} style={{padding:'5px 15px', background:'#dc3545', color:'white', border:'none', cursor:'pointer'}}>Delete</button>
          </li>
        ))}
      </ul>
    </div>
  );
}
export default App;
EOF

